# Copy to .env and fill in. NEVER commit the real .env.
# The live values were found hardcoded in the original source and have been removed.

# --- TradeStation API ---
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_REFRESH_TOKEN=

# --- InfluxDB ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=sma-alerts
INFLUXDB_TOKEN=

# NOTE on the HTML dashboards:
# engine/*.html query InfluxDB from the browser and previously contained the raw token.
# The literal is now the placeholder __INFLUXDB_TOKEN__ . Substitute it at serve time
# (or from chart_server.py) -- do not paste a live token back into a tracked file.
